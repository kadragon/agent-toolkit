{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?set CLAUDE_PLUGIN_ROOT or PLUGIN_ROOT}}/hooks/commit-guard/guard.py\"",
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/commit-guard/guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking commit guard..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?set CLAUDE_PLUGIN_ROOT or PLUGIN_ROOT}}/hooks/memory-guard/guard.py\"",
            "commandWindows": "python \"$env:PLUGIN_ROOT/hooks/memory-guard/guard.py\"",
            "timeout": 5,
            "statusMessage": "Checking memory hygiene..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-${PLUGIN_ROOT:?set CLAUDE_PLUGIN_ROOT or PLUGIN_ROOT}}/hooks/session-start/run.sh\"",
            "commandWindows": "bash \"$env:PLUGIN_ROOT/hooks/session-start/run.sh\"",
            "timeout": 15,
            "statusMessage": "Running session-start maintenance..."
          }
        ]
      }
    ]
  }
}
